# =====================================================
# YouTube to Blog Backend - Environment Variables
# =====================================================
# Copy this file to .env and fill in your actual API keys
# =====================================================
 
# -----------------------------------------------------
# Supabase (Required)
# -----------------------------------------------------
# Get from https://supabase.com Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
 
# -----------------------------------------------------
# YouTube Data API v3 (Required)
# -----------------------------------------------------
# Get from https://console.cloud.google.com/apis/credentials
# 1. Create project -> Enable "YouTube Data API v3"
# 2. Create credentials -> API key
YOUTUBE_API_KEY=your-youtube-api-key-here
 
# -----------------------------------------------------
# GLM API (Zhipu AI) (Required)
# -----------------------------------------------------
# Get from https://open.bigmodel.cn/usercenter/apikeys
# 1. Register account -> Real-name authentication
# 2. User Center -> API Keys
GLM_API_KEY=your-glm-api-key-here
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4/

# Optional: Specify model versions (Optional: Specify model versions)
# GLM_MODEL_TRANSLATE=glm-4-flash
# GLM_MODEL_GENERATE=glm-4-air

# -----------------------------------------------------
# OpenAI API (Optional)
# -----------------------------------------------------
# Get from https://platform.openai.com/api-keys
# Fallback for Whisper audio transcription
# If local Whisper transcription fails, fall back to OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

# -----------------------------------------------------
# Processing Configuration
# -----------------------------------------------------
# Maximum retry attempts
MAX_RETRIES=3

# Skip YouTube Shorts (short videos)
SKIP_SHORTS=true

# Maximum duration for short videos (seconds)
SHORTS_MAX_DURATION=60

# Target translation languages (comma-separated)
TARGET_LANGUAGES=zh-Hans

# Scheduled task (Cron expression)
CRON_SCHEDULE=0 3 * * *
